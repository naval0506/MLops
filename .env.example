# .env.example
# Exemple de fichier d'environnement pour le projet spam‑mlops
# Copiez ce fichier en .env et remplissez les valeurs

# Chemin du modèle entraîné (dans le conteneur) 
MODEL_PATH=model/spam_model.pkl

# Chemin du fichier de métriques
METRICS_PATH=model/metrics.json

# Configuration du registre Harbor (exemple)
HARBOR_HOST=localhost:5000
IMAGE_NAME=spam-detector/spam-api

# Options de pipeline (booléens)
PUSH_TO_HARBOR=false
HARBOR_LOGIN=false
DEPLOY=false

# Si vous déployez sur un serveur distant via SSH, indiquez le host et l'utilisateur
REMOTE_HOST=
REMOTE_USER=
REMOTE_DEPLOY_PATH=/opt/spam-detector
COMPOSE_FILE=docker-compose.prod.yml
